{
  "name": "imposteur",
  "private": true,
  "description": "Jeu de l'imposteur entre amis, sur un seul téléphone",
  "scripts": {
    "web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');for(const f of ['index.html','manifest.webmanifest','sw.js','icons'])fs.cpSync(f,'www/'+f,{recursive:true})\""
  },
